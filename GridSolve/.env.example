# Supabase — copy this file to `.env.local` and fill in your project's values.
# Find them in the Supabase dashboard: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Production site URL — used for sitemap, robots, Open Graph, and auth redirects.
# Set to your real domain before deploying (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ---------------------------------------------------------------------------
# Resend (auth emails — signup confirmation, password reset, etc.)
# ---------------------------------------------------------------------------
# 1. Create an API key at https://resend.com/api-keys
# 2. Verify your sending domain at https://resend.com/domains
# 3. Put the API key here (server-only — never expose in the browser):
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Verified sender address (must use your verified domain in production):
RESEND_FROM_EMAIL=GridSolve <auth@yourdomain.com>
#
# Dev note: if you use Resend's test domain (auth@resend.dev), emails can ONLY
# be sent to the address on your Resend account — sign-ups with any other email
# will fail until you verify your own domain and update RESEND_FROM_EMAIL.

# Supabase Auth "Send Email" hook secret — generated when you enable the hook
# in Supabase Dashboard → Authentication → Hooks → Send Email → HTTPS.
# Paste the full value including the v1,whsec_ prefix:
SEND_EMAIL_HOOK_SECRET=v1,whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# After adding these vars, configure the hook in Supabase:
#   Hook URL: https://your-domain.com/api/auth/send-email
#   (local dev: use ngrok or similar so Supabase can reach localhost)
# Enabling the hook disables Supabase's built-in auth email sending.

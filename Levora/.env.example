# Supabase — copy this file to `.env.local` and fill in your project's values.
# Find them in the Supabase dashboard: Project Settings → API.
# These are the PUBLIC (anon) values, safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Production site URL — used for sitemap, robots, Open Graph, and auth redirects.
# Set to your real domain before deploying (no trailing slash).
# On Vercel, VERCEL_URL is used automatically if this is unset.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Email allowed full explorer access (substation list, scores, detail panels).
# Other signed-in users see the map only and a contact prompt.
NEXT_PUBLIC_EXPLORER_ACCESS_EMAIL=ansh28.dev@gmail.com
